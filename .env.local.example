# Copy to .env.local and fill in.
#
# Required for everything in /api to work:
DATABASE_URL=postgres://launch:launch@localhost:5432/launch

# Required for the credential vault. In dev a 32-byte base64 key is fine;
# rotate to Cloud KMS in production via LAUNCH_KMS_PROVIDER=gcp.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LAUNCH_KMS_MASTER_KEY=

# Required for the Claude analyzer (legacy + LangGraph sidecar).
ANTHROPIC_API_KEY=

# Required for /api/analyze when reading private GitHub repos.
# In production this is a per-user Clerk OAuth token; in dev you can
# stub a personal access token here for testing.
GITHUB_TOKEN=

# Clerk (already in your existing dev setup; listed for completeness).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# === GCP OAuth (one-time setup, optional) ===
#
# Lets the "Authorize via Google" button work in the deploy modal so users
# don't have to paste a service-account JSON.
#
# Setup (5 minutes):
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create OAuth client ID → Web application
#   3. Add redirect URI: http://localhost:3001/api/auth/gcp/callback
#      (and your production URL when deployed)
#   4. Paste the client ID + secret below.
#
# GCP_OAUTH_CLIENT_ID=
# GCP_OAUTH_CLIENT_SECRET=
# GCP_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/gcp/callback

# === Production-grade cloud auth (recommended for B2B) ===
#
# Lets users connect their own AWS / GCP accounts via the production-grade
# flows in the deploy modal:
#   - AWS: CloudFormation Quick-Create + STS:AssumeRole (no keys stored).
#   - GCP: service-account impersonation (no keys stored).

# AWS: the account hosting Sasa Launch — bakes into the trust policy of
# the CloudFormation template users launch. If unset, we fall back to
# STS:GetCallerIdentity using whatever AWS creds are in process.env.
# AWS_PLATFORM_ACCOUNT_ID=123456789012

# GCP: the platform's service-account email — what users grant
# tokenCreator on. On Cloud Run we read this from the metadata server
# automatically; locally, set it explicitly OR have
# GOOGLE_APPLICATION_CREDENTIALS pointed at a JSON key.
# GCP_PLATFORM_SA_EMAIL=sasa-runtime@my-project.iam.gserviceaccount.com

# === Optional ===

# When set, /api/analyze calls the Python LangGraph sidecar instead of the
# legacy single-call analyzer.
# ANALYSIS_SERVICE_URL=http://localhost:8001

# Production-only: Cloud KMS key reference (M1).
# LAUNCH_KMS_PROVIDER=gcp
# LAUNCH_GCP_KMS_KEY_NAME=projects/<proj>/locations/global/keyRings/launch/cryptoKeys/credentials

# Production-only: GCP BigQuery billing export for real cost data (M5).
# LAUNCH_GCP_BILLING_BQ_DATASET=billing_export
# LAUNCH_GCP_BILLING_BQ_TABLE=gcp_billing_export_v1_<billing-account-id>
