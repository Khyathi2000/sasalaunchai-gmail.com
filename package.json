{
  "name": "launch-platform-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "secrets:pull": "node scripts/secrets.mjs pull",
    "secrets:push": "node scripts/secrets.mjs push",
    "secrets:list": "node scripts/secrets.mjs list",
    "logs": "node scripts/logs.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:dev:up": "docker compose up -d postgres",
    "db:dev:down": "docker compose down",
    "db:dev:logs": "docker compose logs -f postgres",
    "db:dev:reset": "docker compose down -v && docker compose up -d postgres"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1026.0",
    "@aws-sdk/client-cost-explorer": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@clerk/nextjs": "^7.3.0",
    "@google-cloud/billing": "^5.1.2",
    "@google-cloud/firestore": "^7.10.0",
    "@google-cloud/kms": "^5.5.0",
    "@google-cloud/monitoring": "^5.3.2",
    "@google-cloud/pubsub": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.4.1",
    "next": "^15.1.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@google-cloud/secret-manager": "^6.1.2",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  }
}
