# For local dev, prefer populating .env.local from GCP Secret Manager:
#   PROJECT_ID=<id> npm run secrets:pull
# This file documents the full set of vars; the managed whitelist lives in
# scripts/secrets.config.mjs.

# Clerk auth (required) — get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Anthropic (required for Claude analysis)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model
# CLAUDE_MODEL=claude-sonnet-4-6

# AWS (only needed when applying real deploys; UI auth bar can also paste these)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP (only needed when applying real deploys; UI auth bar can also paste a service account JSON)
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=
