# Required: Anthropic API key for Claude-powered analysis
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: GitHub token for private repos (increases rate limits)
GITHUB_TOKEN=

# AWS Credentials (required for --apply mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP Credentials (future)
# GOOGLE_APPLICATION_CREDENTIALS=
